meta {
  name: Register test user
  type: http
  seq: 1
}

post {
  url: {{HostUrl}}/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "name": "Bruno Test User",
    "email": "admin@example.com",
    "password": "Industry12345"
  }
}

tests {
  test("registers the fixture user or confirms it already exists", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.be.oneOf([201, 409]);
    if (res.getStatus() === 201) {
      expect(body.user.email).to.equal("admin@example.com");
    }
  });
}
