meta {
  name: Get authenticated user
  type: http
  seq: 3
}

get {
  url: {{HostUrl}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{AuthKey}}
}

tests {
  test("returns the authenticated user", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.id).to.equal(bru.getVar("UserId"));
    expect(body).not.to.have.property("passwordHash");
  });
}
