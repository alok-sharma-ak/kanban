meta {
  name: Create first task
  type: http
  seq: 1
}

post {
  url: {{HostUrl}}/columns/PASTE_COLUMN_ID_HERE/tasks
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "title": "First Bruno task",
    "description": "Temporary task"
  }
}

tests {
  test("creates the first task", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.position).to.equal(1);
    expect(body.columnId).to.be.a("string");
  });
}
