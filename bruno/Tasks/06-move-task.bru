meta {
  name: Move task
  type: http
  seq: 6
}

patch {
  url: {{HostUrl}}/tasks/PASTE_TASK_ID_HERE/move
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "columnId": "PASTE_DESTINATION_COLUMN_ID_HERE",
    "position": 1
  }
}

tests {
  test("moves the task to another column", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.columnId).to.be.a("string");
    expect(body.position).to.equal(1);
  });
}
