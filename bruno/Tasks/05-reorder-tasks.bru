meta {
  name: Reorder tasks
  type: http
  seq: 5
}

patch {
  url: {{HostUrl}}/tasks/reorder
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "columnId": "{{TodoColumnId}}",
    "taskIds": ["{{SecondTaskId}}", "{{FirstTaskId}}"]
  }
}

tests {
  test("reorders all tasks in the column", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.map((task) => task.id)).to.deep.equal([bru.getVar("SecondTaskId"), bru.getVar("FirstTaskId")]);
    expect(body.map((task) => task.position)).to.deep.equal([1, 2]);
  });
}
