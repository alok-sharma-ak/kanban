meta {
  name: Reorder tasks
  type: http
  seq: 5
}

patch {
  url: {{HostUrl}}/tasks/reorder
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "columnId": "PASTE_COLUMN_ID_HERE",
    "taskIds": ["PASTE_FIRST_TASK_ID_HERE", "PASTE_SECOND_TASK_ID_HERE"]
  }
}

tests {
  test("reorders all tasks in the column", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.map((task) => task.position)).to.deep.equal([1, 2]);
  });
}
