meta {
  name: Create second task
  type: http
  seq: 2
}

post {
  url: {{HostUrl}}/columns/{{TodoColumnId}}/tasks
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "title": "Second Bruno task"
  }
}

script:post-response {
  bru.setVar("SecondTaskId", res.getBody().id);
}

tests {
  test("creates the second task", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().position).to.equal(2);
  });
}
