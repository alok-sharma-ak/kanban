meta {
  name: Get board detail
  type: http
  seq: 3
}

get {
  url: {{HostUrl}}/boards/PASTE_BOARD_ID_HERE
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{AuthKey}}
}

tests {
  test("returns nested board detail", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.id).to.be.a("string");
    expect(body.columns).to.be.an("array");
  });
}
