meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{HostUrl}}/auth/logout
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "refreshToken": "PASTE_REFRESH_TOKEN_HERE"
  }
}

tests {
  test("revokes the refresh token", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
