meta {
  name: Update profile
  type: http
  seq: 2
}

patch {
  url: {{HostUrl}}/users/me
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "name": "Admin"
  }
}

tests {
  test("updates the current profile", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("Bruno Updated User");
  });
}
