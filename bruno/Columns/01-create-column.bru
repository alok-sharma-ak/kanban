meta {
  name: Create column
  type: http
  seq: 1
}

post {
  url: {{HostUrl}}/boards/PASTE_BOARD_ID_HERE/columns
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "name": "Review"
  }
}

tests {
  test("appends a column", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.name).to.equal("Review");
    expect(body.position).to.equal(4);
  });
}
