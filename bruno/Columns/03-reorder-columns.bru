meta {
  name: Reorder columns
  type: http
  seq: 3
}

patch {
  url: {{HostUrl}}/columns/reorder
  body: json
  auth: none
}

headers {
  content-type: application/json
  Authorization: Bearer {{AuthKey}}
}

body:json {
  {
    "boardId": "PASTE_BOARD_ID_HERE",
    "columnIds": [
      "PASTE_FIRST_COLUMN_ID_HERE",
      "PASTE_SECOND_COLUMN_ID_HERE",
      "PASTE_THIRD_COLUMN_ID_HERE",
      "PASTE_FOURTH_COLUMN_ID_HERE"
    ]
  }
}

tests {
  test("reorders every board column", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body).to.have.length(4);
    expect(body.map((column) => column.position)).to.deep.equal([1, 2, 3, 4]);
  });
}
