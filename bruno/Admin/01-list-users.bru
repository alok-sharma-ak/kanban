meta {
  name: List system users
  type: http
  seq: 1
}

get {
  url: {{HostUrl}}/admin/users?page=1&limit=20&search=
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{AuthKey}}
}

tests {
  test("returns paginated users to a system admin", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.items).to.be.an("array");
    expect(body.total).to.be.a("number");
  });
}
